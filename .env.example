# Copy to .env for local development (PowerShell: Copy-Item .env.example .env). Never commit .env.
# This file contains only placeholders.

# development = local use. SQLite is allowed ONLY when APP_ENV=development and no database is configured.
APP_ENV=development

# PostgreSQL credentials. The app builds its connection URL from these (special characters are escaped
# for you). The password is written ONCE. The database container applies it only when its data volume is
# first created: to change it later, see "Database credentials" in README.md - do NOT run `docker compose down -v`,
# that deletes the data.
POSTGRES_USER=mik
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=mik_insights

# Optional: a full SQLAlchemy URL overrides the POSTGRES_* values above (older .env files still use this).
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Optional: force a specific questionnaire version (default: highest version in questionnaire/)
# ACTIVE_QUESTIONNAIRE_VERSION=1

# How far back the calendar allows. Empty = any past date (default); a number = that many days (0 = today only).
# Future dates are never allowed. Limit not yet confirmed with management.
MAX_BACKDATE_DAYS=

# Admin session cookie 'Secure' flag. Defaults to on unless APP_ENV is dev/development/test; set 1 when serving over HTTPS.
# COOKIE_SECURE=1

# Only needed behind a proxy/domain that changes the Host header: comma-separated browser origins allowed to POST.
# REQUIRED when APP_ENV is not dev: exact public https:// origin(s), comma separated. COOKIE_SECURE=0 is refused there too.
# ALLOWED_ORIGINS=https://reports.example.com

# PROVISIONAL pilot retention in days (used only by the owner-run scripts/retention_review.py; nothing deletes automatically)
# RETENTION_DAYS=90   (hosted: put it in .env.hosted; read by the `retention` service)
