# Copy to .env for local development. Never commit .env.
POSTGRES_USER=mik
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=mik_insights
DATABASE_URL=postgresql+psycopg://mik:change-me-locally@db:5432/mik_insights
# Optional: force a specific questionnaire version (default: highest version in questionnaire/)
# ACTIVE_QUESTIONNAIRE_VERSION=1
# How many days back an employee may log work for (0 = today only)
MAX_BACKDATE_DAYS=1
